#!/usr/bin/env bash
# Enforces the Conventional Commits format documented in CONTRIBUTING.md.
set -euo pipefail

subject=$(head -n 1 "$1")

# Merge and revert subjects are generated by git itself.
case "$subject" in
Merge* | Revert*) exit 0 ;;
esac

pattern='^(feat|fix|docs|chore|refactor|test|perf|build|ci|style)(\([a-z0-9/._-]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
	cat >&2 <<'USAGE'
commit-msg: subject does not follow Conventional Commits

  <type>(<scope>): <description>

  type   feat fix docs chore refactor test perf build ci style
  scope  optional; language-prefixed for code changes

  examples
    feat(go/agent): add plan approval step
    fix(ts/components): fix button alignment
    chore(shell/build): update test script
    docs: update release workflow
USAGE
	echo "  got: $subject" >&2
	exit 1
fi
